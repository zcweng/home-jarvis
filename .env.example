# home-jarvis 配置模板 —— 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，别提交。
#
#   cp .env.example .env
#
# 代码里零硬编码，迁移换机（比如搬到常开的 MacMini）只改这个文件。

# ---- 密钥（必填） ----
HA_TOKEN=               # HA → 个人资料 → 安全 → 长期访问令牌（scripts/set_ha_token.py 可验证后写入）
DEEPSEEK_KEY=           # https://platform.deepseek.com/api_keys

# ---- 服务地址 ----
HA_URL=http://127.0.0.1:8123
LLM_MODEL=deepseek-flash        # 控制类走 flash；闲聊可换更大的模型
LLM_BASE_URL=https://api.deepseek.com

# ---- 音频设备 ----
# 按名字子串匹配，插拔/换机不用改代码；留空=系统默认。
# 先跑 `.venv/bin/python -m jarvis.audio list` 看本机设备名。
INPUT_DEVICE=                   # 例如：外置麦克风（未命中会回落默认并告警）
OUTPUT_DEVICE=                  # 例如：MacBook Pro扬声器

# ---- TTS 后端 ----
TTS_BACKEND=neural              # neural=本地 VITS（自然，默认）| say=系统合成（快但生硬，仅 macOS）
TTS_VOICE_SAY=Tingting          # 系统 zh_CN 语音（个人语音类音色会渲染空音频，别用）
TTS_MODEL_DIR=models/vits-zh-hf-fanchen-C   # ./scripts/fetch_models.sh tts
TTS_SPEED=1.35                  # 语速倍数（1.0 明显偏慢；1.3~1.5 接近日常语速）
SAY_RATE=170                    # macOS say 语速
# direct=~50ms 出声走系统默认输出 | wav=~460ms 但能指定设备
TTS_MODE=direct

# ---- ASR（sherpa-onnx SenseVoice） ----
ASR_MODEL_DIR=models/sensevoice
ASR_LANGUAGE=zh                 # zh 强制中文；auto 让模型自判（短句容易误判）

# ---- VAD（断句）----
VAD_MODEL=models/silero-vad/silero_vad.onnx
VAD_THRESHOLD=0.5               # 灵敏度过低会切碎，过高会并句

# ---- 唤醒词（多个用 | 分隔）----
WAKE_WORDS=贾维斯|小贾|管家
WAKE_BACKEND=kws                # kws=专用关键词模型（快，13MB）| asr=整句识别后再判（零额外模型）
KWS_MODEL=models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01

# ---- 会话行为 ----
FOLLOW_UP_SECONDS=8             # 免唤醒续聊窗口，从「播报结束」开始计时
VAD_SILENCE_MS=500              # 断句静音阈值

# ---- 收线指令（说完立刻退出连续对话，需重新唤醒；整句比对，不会误判「退出节能模式」）----
SLEEP_WORDS=退下吧|退下|退出|退出对话|结束|结束对话|再见|拜拜|不聊了|没事了|休息吧|你去忙吧
SLEEP_REPLY=好，有事叫我。

# ---- 首句先出声 / 打断 ----
ACK_PHRASES=好的|嗯|收到        # 预渲染的短应答，比模型终答早 ~600ms 出声
BARGE_IN_MARGIN_DB=12           # 打断阈值：高出回声基线 12dB

# ---- 播报（小爱音箱 play_text）----
ANNOUNCE_ENTITY=               # 留空=自动发现带 play_text 的 notify 实体
ANNOUNCE_MAX_CHARS=80          # 单条上限，超了按句切分

# ---- 语音输出路由 ----
# speaker=优先从小爱音箱出声（默认）| local=只用电脑喇叭 | both=两边都说（调试，有回声）
TTS_TARGET=speaker
SPEAKER_FALLBACK_LOCAL=true    # 音箱不可达或云端报错时回落电脑喇叭
