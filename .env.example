# home-jarvis 配置模板 —— 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，别提交。
#
#   cp .env.example .env
#
# 代码里零硬编码，迁移换机（比如搬到常开的 MacMini）只改这个文件。

# ---- 密钥（必填） ----
HA_TOKEN=               # HA → 个人资料 → 安全 → 长期访问令牌（scripts/set_ha_token.py 可验证后写入）
# LLM：优先 LLM_API_KEY；未设时回退 DEEPSEEK_KEY（兼容旧配置）
LLM_API_KEY=            # 任意 OpenAI 兼容网关的 key
DEEPSEEK_KEY=           # https://platform.deepseek.com/api_keys（DeepSeek 时可用）

# ---- 服务地址 ----
HA_URL=http://127.0.0.1:8123

# ---- LLM（OpenAI Agents SDK · Chat Completions 兼容）----
LLM_MODEL=deepseek-flash        # 控制类走 flash；闲聊可换更大的模型 / 其它厂商模型名
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=3                   # 单次 LLM HTTP 超时（秒）
LLM_PROVIDER=                   # 空=按 base_url 推断；deepseek | openai_compatible
LLM_DISABLE_THINKING=false      # true=强制 thinking.disabled（DeepSeek 工具调用必需时也可靠 provider 推断）
# 可选 MCP 服务器（JSON 数组）。空=不挂。示例 stdio filesystem：
# MCP_SERVERS=[{"type":"stdio","name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
# 示例 Streamable HTTP：[{"type":"http","name":"remote","url":"http://127.0.0.1:8000/mcp"}]
MCP_SERVERS=
# Tool Search（客户端 defer_loading）：true=MCP/长尾本地工具经 tool_search 发现；false=全量挂载（旧行为）
TOOL_SEARCH_ENABLED=true
TOOL_SEARCH_DEFER_LOCAL=web_search,web_fetch,memory
TOOL_SEARCH_LIMIT=5

# ---- 音频设备 ----
# 按名字子串匹配，插拔/换机不用改代码；留空=系统默认。
# 先跑 `.venv/bin/python -m jarvis.audio list` 看本机设备名。
INPUT_DEVICE=                   # 例如：外置麦克风（未命中会回落默认并告警）
OUTPUT_DEVICE=                  # 例如：MacBook Pro扬声器
# local=本机麦/喇叭 | speaker_endpoint=S12（tools/s12audio，命令行也可 --endpoint）
AUDIO_SOURCE=local
SPEAKER_ENDPOINT=192.168.1.3    # 或 tcp://192.168.1.3:8765
SPEAKER_DOWN_PORT=8766          # 下行 framed PCM
LED_ENABLED=true                # S12 灯环（需设备端 /data/jarvis-led-set.sh）
LED_PORT=8767                   # 保留字段
VOLUME_PERCENT=70               # 开机默认音量 0-100
VOLUME_UDP_PORT=8769            # 设备音量环 → Mac

# ---- TTS 后端 ----
TTS_BACKEND=neural              # neural=本地 VITS | nano=MOSS-TTS-Nano | say=系统合成 | qwen=千问 Realtime
TTS_VOICE_SAY=Tingting          # 系统 zh_CN 语音（个人语音类音色会渲染空音频，别用）
TTS_MODEL_DIR=models/vits-zh-hf-fanchen-C   # ./scripts/fetch_models.sh tts
TTS_SPEED=1.35                  # 语速倍数（1.0 明显偏慢；1.3~1.5 接近日常语速）
SAY_RATE=170                    # macOS say 语速
# direct=~50ms 出声走系统默认输出 | wav=~460ms 但能指定设备
TTS_MODE=direct
TTS_FALLBACK=neural             # nano/qwen 失败回落 neural | say | none
# Nano 侧车（先 ./scripts/nano_tts_server.sh start --bg，再把 TTS_BACKEND=nano）
TTS_NANO_URL=http://127.0.0.1:8091
TTS_NANO_REF_AUDIO=tools/nano-tts/MOSS-TTS-Nano/assets/audio/zh_1.wav  # 官方音色；自录可改 refs/owner.wav
TTS_NANO_STREAM=true
TTS_NANO_TIMEOUT=8
TTS_NANO_SPEED=1.0
TTS_NANO_FALLBACK=neural        # 兼容旧键；优先用 TTS_FALLBACK
# 千问AI平台 Realtime TTS（CosyVoice WebSocket；文档 platform.qianwenai.com）
DASHSCOPE_API_KEY=              # 千问平台 API Key
TTS_QWEN_WS_URL=wss://maas.qianwenaiapi.com/api-ws/v1/inference
TTS_QWEN_MODEL=cosyvoice-v3-flash
TTS_QWEN_VOICE=longanyang
TTS_QWEN_SAMPLE_RATE=24000
TTS_QWEN_TIMEOUT=8
TTS_QWEN_SPEED=1.0

# ---- ASR（sherpa-onnx SenseVoice） ----
ASR_MODEL_DIR=models/sensevoice
ASR_LANGUAGE=zh                 # zh 强制中文；auto 让模型自判（短句容易误判）

# ---- VAD（断句）----
VAD_MODEL=models/silero-vad/silero_vad.onnx
VAD_THRESHOLD=0.5               # 灵敏度过低会切碎，过高会并句

# ---- 唤醒词（多个用 | 分隔）----
WAKE_WORDS=贾维斯|小贾|管家
WAKE_BACKEND=kws                # kws=专用关键词模型（快，13MB）| asr=整句识别后再判（零额外模型）
KWS_MODEL=models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01

# ---- 会话行为 ----
FOLLOW_UP_SECONDS=8             # 免唤醒续聊窗口，从「播报结束」开始计时
VAD_SILENCE_MS=500              # 断句静音阈值

# ---- 收线指令（说完立刻退出连续对话，需重新唤醒；整句比对，不会误判「退出节能模式」）----
SLEEP_WORDS=退下吧|退下|退出|退出对话|结束|结束对话|再见|拜拜|不聊了|没事了|休息吧|你去忙吧
SLEEP_REPLY=好，有事叫我。

# ---- 首句先出声 / 打断 ----
ACK_PHRASES=好的|嗯|收到        # 预渲染的短应答，比模型终答早 ~600ms 出声
BARGE_IN_MARGIN_DB=18           # 打断阈值：高出回声底(85分位) 18dB；过低易被自己播报误触

# ---- 播报（小爱音箱 play_text）----
ANNOUNCE_ENTITY=               # 留空=自动发现带 play_text 的 notify 实体
ANNOUNCE_MAX_CHARS=80          # 单条上限，超了按句切分

# ---- 语音输出路由 ----
# speaker=优先从小爱音箱出声（默认）| local=只用电脑喇叭 | both=两边都说（调试，有回声）
# 注意：AUDIO_SOURCE=speaker_endpoint 时会强制走 local（PCM 下发 S12），忽略本项的 speaker 云端路径
TTS_TARGET=speaker
SPEAKER_FALLBACK_LOCAL=true    # 音箱不可达或云端报错时回落电脑喇叭

# ---- 天气（中国气象局 weather.cma.cn，无 API key）----
WEATHER_ENABLED=true            # false=不注册 weather 工具
WEATHER_TIMEOUT=3               # 单次请求超时（秒）
WEATHER_DEFAULT_CITY=成都       # 用户没说城市时的默认

# ---- 网页搜索（SearXNG + Crawl4AI；需 uv sync --extra web）----
# 起 SearXNG：docker compose -f docker/docker-compose.yml up -d searxng
# 首次抓取前：.venv/bin/crawl4ai-setup（装 Playwright 浏览器）
WEB_SEARCH_ENABLED=true         # false=不注册 web_search / web_fetch
WEB_SEARCH_COUNT=5              # 取前几条标题+摘要
WEB_SEARCH_TIMEOUT=8            # SearXNG 请求超时（秒）
WEB_FETCH_TIMEOUT=15            # Crawl4AI 抓取超时（秒）
WEB_FETCH_MAX_CHARS=3000        # 单次 web_fetch 正文切片字数
SEARXNG_BASE_URL=http://127.0.0.1:8888
LOCAL_WEB_SEARCH_CACHE=.cache/local_agentic_search.sqlite3

# ---- 分层记忆（本地 SQLite + ONNX 向量；默认关，行为与现网一致）----
# 依赖：uv sync --extra memory；模型：./scripts/fetch_models.sh memory
MEMORY_ENABLED=false
MEMORY_DB=data/memory/jarvis_memory.sqlite3
MEMORY_MODEL_DIR=models/bge-small-zh-v1.5
MEMORY_TOKEN_BUDGET=800              # 注入 prompt 的记忆 token 上限
MEMORY_SHORT_HALF_LIFE_DAYS=180      # 短期记忆半衰期（天）；要 6 小时衰减可改 0.25
MEMORY_MIN_IMPORTANCE=0.45           # 分类器采信门槛
MEMORY_RERANK=score                  # score | llm | off
MEMORY_RECALL_K=8                    # 短期臂召回条数
MEMORY_LLM_MODEL=                    # 空=复用 LLM_MODEL，专用于分类/摘要
MEMORY_EPISODE_EVERY=6               # 每 N 轮压一条短期情景
MEMORY_COMPRESS_AT_MESSAGES=24       # 会话原文超此条数触发压缩
MEMORY_MISSED_GRACE=600              # 重启后补报闹钟的宽限秒数
