# ---- 密钥与本地数据（绝不提交）----
.env
.env.*
!.env.example
.env.local
*.bak

# HA 运行数据（含小米账号 token 明文）
docker/config/
docker/*/data/

# 设备别名表：每家的设备都不一样，自己生成（模板见 config/aliases.example.yaml）
config/aliases.yaml

# 本机 agent 记忆与个人上下文（不公开）
.agents/

# 模型文件（用 scripts/fetch_models.sh 在目标机重新下）
models/

# Python
__pycache__/
*.py[cod]
.venv/
uv.lock.bak

# macOS
.DS_Store

# 音频调试产物
*.wav
*.mp3
debug/

# uv 本地缓存（本机 ~/.cache 不可写时的替代）
.uv-cache/

# 编辑器
.idea/
.vscode/
